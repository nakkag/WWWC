        MENUITEM SEPARATOR
        MENUITEM "アイコンを初期化(&I)\tCtrl+I",        ID_MENUITEM_INITICON
        MENUITEM "すべてのアイコンを初期化(&T)",            ID_MENUITEM_ALLINITICON
        MENUITEM SEPARATOR
        POPUP "アイコン変更(&N)"
        BEGIN
            MENUITEM "UPアイコン(&U)",                  ID_MENUITEM_ICON_UP
            MENUITEM "エラーアイコン(&E)",                 ID_MENUITEM_ICON_ERROR
            MENUITEM "タイムアウトアイコン(&T)",              ID_MENUITEM_ICON_TIMEOUT
            MENUITEM SEPARATOR
