/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU_MAIN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New",                        ID_MENUITEM_POP_NEWITEM
        MENUITEM SEPARATOR
        MENUITEM "&Delete",                     ID_MENUITEM_DELETE
        MENUITEM "Rena&me",                     ID_MENUITEM_EDITNAME
        MENUITEM "P&roperties...",              ID_MENUITEM_PROP
        MENUITEM SEPARATOR
        MENUITEM "&Close",                      ID_MENUITEM_CLOSE
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",               ID_MENUITEM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",                ID_MENUITEM_CUT
        MENUITEM "&Copy\tCtrl+C",               ID_MENUITEM_COPY
        MENUITEM "&Paste\tCtrl+V",              ID_MENUITEM_PASTE
        MENUITEM SEPARATOR
        MENUITEM "Select &All\tCtrl+A",         ID_MENUITEM_ALLSELECT
        MENUITEM "&Invert Selection",           ID_MENUITEM_SWITCHSELECT
        MENUITEM "Select Up&dated Items\tCtrl+B", ID_MENUITEM_UPSELECT
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F",            ID_MENUITEM_SERACH
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Toolbar",                    ID_MENUITEM_VIEW_TB
        MENUITEM "Status &Bar",                 ID_MENUITEM_VIEW_SB
        MENUITEM "&Update Message...\tCtrl+U",  ID_MENUITEM_VIEWUPMSG
        MENUITEM SEPARATOR
        MENUITEM "Lar&ge Icons",                ID_MENUITEM_VIEW_ICON
        MENUITEM "S&mall Icons",                ID_MENUITEM_VIEW_SMALLICON
        MENUITEM "&List",                       ID_MENUITEM_VIEW_LIST
        MENUITEM "&Details",                    ID_MENUITEM_VIEW_REPORT
        MENUITEM "Details with &Full Row Select", ID_MENUITEM_VIEW_REPORT_LINE
        MENUITEM SEPARATOR
        POPUP "Arrange &Icons"
        BEGIN
            MENUITEM "by &Icon",                    ID_MENUITEM_SORT_ICON
            MENUITEM "by &Name",                    ID_MENUITEM_SORT_NAME
            MENUITEM "by Si&ze",                    ID_MENUITEM_SORT_SIZE
            MENUITEM "by &Date",                    ID_MENUITEM_SORT_DATE
            MENUITEM "by &URL",                     ID_MENUITEM_SORT_URL
            MENUITEM SEPARATOR
            MENUITEM "Auto &Sort",                  ID_MENUITEM_AUTOSORT
        END
        MENUITEM SEPARATOR
        POPUP "Na&vigate"
        BEGIN
            MENUITEM "&Back\tAlt+Left",             ID_MENUITEM_PREV_HISTORY
            MENUITEM "&Forward\tAlt+Right",         ID_MENUITEM_NEXT_HISTORY
        END
        MENUITEM "&Refresh",                    ID_MENUITEM_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Customize Toolbar...",       ID_MENUITEM4_TB_CUSTOM
        MENUITEM "&Options...",                 ID_MENUITEM_OPTION
    END
    POPUP "&Check"
    BEGIN
        MENUITEM "&Check\tF5",                  ID_MENUITEM_CHECK
        MENUITEM "Check &All Items\tCtrl+F5",   ID_MENUITEM_ALLCHECK
        MENUITEM "Check with Sub&folders",      ID_MENUITEM_FOLDERTREECHECK
        MENUITEM "Check &Error Items Only",     ID_MENUITEM_ALLERRORCHECK
        MENUITEM SEPARATOR
        MENUITEM "&Stop Check\tCtrl+S",         ID_MENUITEM_CHECKEND
        MENUITEM "Sto&p All Checks\tCtrl+T",    ID_MENUITEM_ALLCHECKEND
        MENUITEM SEPARATOR
        MENUITEM "Reset &Icon\tCtrl+I",         ID_MENUITEM_INITICON
        MENUITEM "Reset All Ic&ons",            ID_MENUITEM_ALLINITICON
        MENUITEM SEPARATOR
        POPUP "Change Ico&n"
        BEGIN
            MENUITEM "&Updated Icon",               ID_MENUITEM_ICON_UP
            MENUITEM "&Error Icon",                 ID_MENUITEM_ICON_ERROR
            MENUITEM "&Timeout Icon",               ID_MENUITEM_ICON_TIMEOUT
            MENUITEM SEPARATOR
            MENUITEM "Check / Do &Not Check",       ID_MENUITEM_CHECKSWITCH
        END
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM SEPARATOR
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help",                       ID_MENUITEM_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About WWWC...",              ID_MENUITEM_ABOUT
    END
END

IDR_MENU_POPUP MENU
BEGIN
    POPUP "&New"
    BEGIN
        MENUITEM "&Folder",                     ID_MENUITEM_NEWFOLDER
        MENUITEM SEPARATOR
    END
    POPUP "Item"
    BEGIN
        MENUITEM "Chec&k",                      ID_MENUITEM_CHECK_POP
        MENUITEM "&Stop Check",                 ID_MENUITEM_CHECKEND_POP
        MENUITEM SEPARATOR
        MENUITEM "Reset &Icon",                 ID_MENUITEM_INITICON_POP
        POPUP "Change Ico&n"
        BEGIN
            MENUITEM "&Updated Icon",               ID_MENUITEM_ICON_UP
            MENUITEM "&Error Icon",                 ID_MENUITEM_ICON_ERROR
            MENUITEM "&Timeout Icon",               ID_MENUITEM_ICON_TIMEOUT
            MENUITEM SEPARATOR
            MENUITEM "Check / Do &Not Check",       ID_MENUITEM_CHECKSWITCH_POP
        END
        MENUITEM SEPARATOR
        MENUITEM "Cu&t",                        ID_MENUITEM_CUT_POP
        MENUITEM "&Copy",                       ID_MENUITEM_COPY_POP
        MENUITEM SEPARATOR
        MENUITEM "&Delete",                     ID_MENUITEM_DELETE_POP
        MENUITEM "Rena&me",                     ID_MENUITEM_EDITNAME_POP
        MENUITEM SEPARATOR
        MENUITEM "P&roperties...",              ID_MENUITEM_PROP_POP
    END
    POPUP "Folder"
    BEGIN
        MENUITEM "Check with Sub&folders",      ID_MENUITEM_FOLDERTREECHECK
        MENUITEM "Chec&k",                      ID_MENUITEM_CHECK
        MENUITEM "&Stop Check",                 ID_MENUITEM_CHECKEND
        MENUITEM "Reset &Icon",                 ID_MENUITEM_INITICON
        MENUITEM SEPARATOR
        POPUP "&View"
        BEGIN
            MENUITEM "Lar&ge Icons",                ID_MENUITEM_VIEW_ICON
            MENUITEM "S&mall Icons",                ID_MENUITEM_VIEW_SMALLICON
            MENUITEM "&List",                       ID_MENUITEM_VIEW_LIST
            MENUITEM "&Details",                    ID_MENUITEM_VIEW_REPORT
            MENUITEM "Details with &Full Row Select", ID_MENUITEM_VIEW_REPORT_LINE
        END
        MENUITEM SEPARATOR
        POPUP "Arrange Ic&ons"
        BEGIN
            MENUITEM "by &Icon",                    ID_MENUITEM_SORT_ICON
            MENUITEM "by &Name",                    ID_MENUITEM_SORT_NAME
            MENUITEM "by Si&ze",                    ID_MENUITEM_SORT_SIZE
            MENUITEM "by &Date",                    ID_MENUITEM_SORT_DATE
            MENUITEM "by &URL",                     ID_MENUITEM_SORT_URL
            MENUITEM SEPARATOR
            MENUITEM "Auto &Sort",                  ID_MENUITEM_AUTOSORT
        END
        MENUITEM SEPARATOR
        MENUITEM "&Paste",                      ID_MENUITEM_PASTE
        MENUITEM "&Undo",                       ID_MENUITEM_UNDO
        MENUITEM "&Find...",                    ID_MENUITEM_SERACH
        MENUITEM SEPARATOR
        MENUITEM "&New",                        ID_MENUITEM_POP_NEWITEM
        MENUITEM SEPARATOR
        MENUITEM "P&roperties...",              ID_MENUITEM_PROP
    END
    POPUP "Drag and Drop"
    BEGIN
        MENUITEM "&Copy Here",                  ID_MENU_DGDP_COPY
        MENUITEM "&Move Here",                  ID_MENU_DGDP_CUT
        MENUITEM SEPARATOR
        MENUITEM "Cancel",                      ID_MENU_DGDP_CANCEL
    END
    POPUP "Updated Item"
    BEGIN
        MENUITEM "Reset &Icon\tCtrl+I",         ID_MENUITEM_INITICON_POP
        MENUITEM "Reset All Ic&ons",            ID_MENUITEM_ALLINITICON
        MENUITEM SEPARATOR
        MENUITEM "&View\tCtrl+E",               ID_MENUITEM_UPVIEW
        MENUITEM "&Copy\tCtrl+C",               ID_MENUITEM_COPY
        MENUITEM SEPARATOR
        MENUITEM "P&roperties...",              ID_MENUITEM_PROP
    END
    POPUP "Task Tray"
    BEGIN
        MENUITEM "&Check All Items",            ID_MENUITEM_ALLCHECK
        MENUITEM "Sto&p All Checks",            ID_MENUITEM_ALLCHECKEND
        MENUITEM "&Auto Check",                 ID_MENUITEM_AUTOCHECK
        MENUITEM SEPARATOR
        MENUITEM "&Update Message...",          ID_MENUITEM_VIEWUPMSG
        MENUITEM "&Options...",                 ID_MENUITEM_OPTION
        MENUITEM SEPARATOR
        MENUITEM "&Restore",                    ID_MENUITEM_REWINDOW
        MENUITEM "E&xit",                       ID_MENUITEM_END
    END
    POPUP "Update Message"
    BEGIN
        MENUITEM "Select &All\tCtrl+A",         ID_MENUITEM_ALLSELECT
        MENUITEM "Reset All Ic&ons",            ID_MENUITEM_ALLINITICON
        MENUITEM SEPARATOR
        MENUITEM "&Clear",                      ID_MENUITEM_UPITEMCLEAR
    END
END


