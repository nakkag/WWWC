            MENUITEM "次に進む(&F)\tAlt+→",             ID_MENUITEM_NEXT_HISTORY
        END
        MENUITEM "最新の情報に更新(&R)",                ID_MENUITEM_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "ツール バーのカスタマイズ(&C)...",        ID_MENUITEM4_TB_CUSTOM
        MENUITEM "オプション(&O)...",                ID_MENUITEM_OPTION
    END
    POPUP "チェック(&C)"
    BEGIN
        MENUITEM "チェック(&E)\tF5",                ID_MENUITEM_CHECK
        MENUITEM "すべてのアイテムをチェック(&A)\tCtrl+F5",  ID_MENUITEM_ALLCHECK
