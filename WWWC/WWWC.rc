IDR_MENU_MAIN MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "新規作成(&N)",                    ID_MENUITEM_POP_NEWITEM
        MENUITEM SEPARATOR
        MENUITEM "削除(&D)",                      ID_MENUITEM_DELETE
        MENUITEM "名前の変更(&M)",                   ID_MENUITEM_EDITNAME
        MENUITEM "プロパティ(&R)...",                ID_MENUITEM_PROP
        MENUITEM SEPARATOR
        MENUITEM "閉じる(&C)",                     ID_MENUITEM_CLOSE
    END
    POPUP "編集(&E)"
    BEGIN
