IDD_DIALOG_UP DIALOGEX 0, 0, 246, 180
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "WWWC - [更新メッセージ]"
FONT 9, "ＭＳ Ｐゴシック", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "参照(&V)",IDC_BUTTON_VIEW,190,10,50,15,WS_GROUP
    PUSHBUTTON      "待機(&W)",IDC_BUTTON_WAIT,190,30,50,15
    PUSHBUTTON      "詳細(&D) >>",IDC_BUTTON_INFO,190,50,50,15
    CONTROL         "",WWWC_LIST,"SysListView32",LVS_REPORT | LVS_SHAREIMAGELISTS | WS_BORDER | WS_TABSTOP,0,70,245,110
    ICON            "",IDC_STATIC_ICON,10,10,20,20
    LTEXT           "更新されたアイテムはありません。",IDC_STATIC_MSG,35,10,150,35
    CONTROL         "",IDC_STATIC_BANNER,"Static",SS_BITMAP | SS_NOTIFY | SS_SUNKEN | NOT WS_VISIBLE,35,45,14,15
END

IDD_DIALOG_DLLLIST DIALOG 0, 0, 150, 155
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "プロトコルリスト"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    CONTROL         "",IDC_STATIC_FILENAME,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,0,0,150,10
