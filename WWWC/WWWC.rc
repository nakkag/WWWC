        MENUITEM SEPARATOR
        MENUITEM "検索(&F)...\tCtrl+F",           ID_MENUITEM_SERACH
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "ツール バー(&T)",                  ID_MENUITEM_VIEW_TB
        MENUITEM "ステータス バー(&B)",                ID_MENUITEM_VIEW_SB
        MENUITEM "更新メッセージ(&U)...\tCtrl+U",      ID_MENUITEM_VIEWUPMSG
        MENUITEM SEPARATOR
