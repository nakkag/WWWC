    DEFPUSHBUTTON   "OK",IDOK,40,135,50,14
    PUSHBUTTON      "キャンセル",IDCANCEL,95,135,50,14
END

IDD_DIALOG_PRPTOCOLEDIT DIALOG 0, 0, 204, 159
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "プロトコル編集"
FONT 9, "ＭＳ Ｐゴシック"
BEGIN
    LTEXT           "タイトル(&T):",IDC_STATIC,10,5,35,10
