            MENUITEM "サイズ順(&Z)",                    ID_MENUITEM_SORT_SIZE
            MENUITEM "日付順(&D)",                     ID_MENUITEM_SORT_DATE
            MENUITEM "URL順(&U)",                    ID_MENUITEM_SORT_URL
            MENUITEM SEPARATOR
            MENUITEM "自動ソート(&S)",                   ID_MENUITEM_AUTOSORT
        END
        MENUITEM SEPARATOR
        POPUP "移動(&V)"
        BEGIN
